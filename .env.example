# Copia in .env e personalizza. Non committare mai .env.
# Password del database: scegline una (es. `openssl rand -hex 16`) e usala in entrambe le righe.
POSTGRES_PASSWORD=
DATABASE_URL="postgresql://opentax:<POSTGRES_PASSWORD>@localhost:5432/opentax?schema=public"
API_PORT=3000
# Interfaccia di ascolto dell'API. Default 127.0.0.1: non esporla in rete finché manca l'autenticazione.
# API_HOST=127.0.0.1
# Host name accettati da API e web (protezione contro il DNS rebinding). Default: localhost,127.0.0.1,::1
# ALLOWED_HOSTS=
# Chiave per cifrare a riposo i segreti dei tenant (credenziali PEC, IBAN). 32 byte base64.
APP_ENCRYPTION_KEY=""
NEXT_PUBLIC_API_URL=http://localhost:3000/api
# Directory dei file generati (XML fatture, ricevute SDI). Default: apps/api/storage
STORAGE_DIR=
# Optional: URL of the official AdE "Modello F24 Ordinario" PDF used to print F24 forms (downloaded once, cached in storage/models).
# F24_MODEL_URL=

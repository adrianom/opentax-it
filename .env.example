# Copia in .env e personalizza. Non committare mai .env.
DATABASE_URL="postgresql://opentax:opentax@localhost:5432/opentax?schema=public"
API_PORT=3000
# Chiave per cifrare a riposo i segreti dei tenant (credenziali PEC, IBAN). 32 byte base64.
APP_ENCRYPTION_KEY=""
NEXT_PUBLIC_API_URL=http://localhost:3000/api
# Directory dei file generati (XML fatture, ricevute SDI). Default: apps/api/storage
STORAGE_DIR=
# Optional: URL of the official AdE "Modello F24 Ordinario" PDF used to print F24 forms (downloaded once, cached in storage/models).
# F24_MODEL_URL=
